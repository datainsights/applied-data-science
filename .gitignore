# =====================================================
# Quarto build artifacts
# =====================================================

_site/
.quarto/
_cache/
_freeze/

# Ignore HTML everywhere except the rendered site in docs/
*.html
!docs/**/*.html

# Ignore Quarto figure folders except those in docs/
*_files/
!docs/**/*_files/
!docs/**/*_files/**

# Ignore locally exported documents
*.pdf
*.docx


# =====================================================
# Python
# =====================================================

.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.ipynb_checkpoints/

# Testing and coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type-checking and linting caches
.mypy_cache/
.ruff_cache/


# =====================================================
# Environment variables and local configuration
# =====================================================

.env
.env.*
!.env.example


# =====================================================
# R
# =====================================================

.Rhistory
.RData
.Rproj.user/


# =====================================================
# OS and editor files
# =====================================================

.DS_Store
Thumbs.db
.vscode/
.idea/


# =====================================================
# Logs
# =====================================================

*.log


# =====================================================
# Project outputs
# Keep small teaching/demo artifacts; ignore replacements
# =====================================================

data/raw/*
!data/raw/people-example.csv

data/processed/*
!data/processed/model-ready-example.csv

models/*
!models/diabetes-linear-regression.joblib

reports/*
!reports/*.csv
!reports/figures/
!reports/figures/*.png

REFER/
/.quarto/
